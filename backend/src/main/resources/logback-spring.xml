<?xml version="1.0" encoding="UTF-8"?>
<!-- 
================================================================================
SMART MONITOR PLATFORM - ENTERPRISE LOGGING SUBSYSTEM CONFIGURATION (LOGBACK)
================================================================================
DESCRIPTION:
This XML configuration orchestrates the application logging infrastructure for the 
Spring Boot backend. It mirrors the exact structural logic of the Python 'logger.py'
to ensure operational continuity, unified troubleshooting interfaces, and metrics archiving.

KEY ARCHITECTURAL FEATURES:
1. Thread-safe & non-blocking asynchronous log writing natively handled by Logback.
2. Hard resource bounding (Max 5MB per file, rotating across up to 3 historic backups) 
   preventing server disk exhaustion (storage depletion) under intensive operational loads.
3. Dual-stream targeting: Pipes raw standard streams (STDOUT) directly to container engines 
   (Docker/Kubernetes/systemd) while simultaneously isolating structured application 
   errors and telemetry anomalies into physically segregated on-disk log files.
================================================================================
-->
<configuration>

    <!-- 
      GLOBAL PROPERTIES: 
      These variables act as a single source of truth for physical file management.
      - LOG_DIR: Target folder for log storage.
      - MAX_FILE_SIZE: Trigger threshold for rotating an active log file.
      - MAX_BACKUP_INDEX: Hard limit on archival retention loops (deletes older indexes).
    -->
    <property name="LOG_DIR" value="logs" />
    <property name="MAX_FILE_SIZE" value="5MB" />
    <property name="MAX_BACKUP_INDEX" value="3" />

    <!-- 
      1. CONSOLE APPENDER (Real-Time Standard Stream Integration):
      Pipes application diagnostics directly to STDOUT.
      Crucial for cloud-native orchestration logs retrieval (e.g., 'docker logs' or 'journalctl').
    -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- 
              ISO-8601 Compliance Standard Pattern:
              %d : Detailed Timestamp (YYYY-MM-DD HH:MM:SS.SSS)
              %-5level : Aligned Log Severity (INFO, WARN, ERROR, etc.)
              [%thread] : Active thread name handling the executing request context
              %logger{36} : Origin class package name truncated safely to 36 chars
              %msg%n : Log message payload and platform-specific newline 
            -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} | %-5level | [%thread] | %logger{36} | %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 
      2. SYSTEM FILE APPENDER (Unified Operational Ledger):
      Persists all core application metrics, boot logs, and general trace logs to 'system.log'.
      Maintains auto-rotation using Size and Time-Based policies.
    -->
    <appender name="SYSTEM_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/system.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 
              Rotation naming convention:
              Tracks hourly/daily changes using dates, while adding an integer index '%i' 
              whenever the physical file limit (5MB) is hit within the same day cycle.
            -->
            <fileNamePattern>${LOG_DIR}/system-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_BACKUP_INDEX}</maxHistory>
            <totalSizeCap>20MB</totalSizeCap> <!-- Hard cap constraint to enforce disk-safety -->
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} | %-5level | [%thread] | %logger{36} | %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 
      3. ALERT FILE APPENDER (Incident-Specific Segregated Repository):
      Directly isolating system anomalies and security breaches into 'alerts.log'.
      Designed to filter out noise, capturing ONLY high-severity events (WARNING and ERROR).
    -->
    <appender name="ALERT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/alerts.log</file>
        
        <!-- Threshold Filter: Rejects any log event with severity lower than WARN -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/alerts-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_BACKUP_INDEX}</maxHistory>
            <totalSizeCap>20MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} | %-5level | [%thread] | %logger{36} | %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 
      ROOT ROOTING SCHEMA:
      Sets global baseline severity capture to INFO.
      Binds and executes all defined appenders concurrently.
    -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="SYSTEM_FILE" />
        <appender-ref ref="ALERT_FILE" />
    </root>

</configuration>