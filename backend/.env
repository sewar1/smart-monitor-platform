# ==============================================================================
# SMART MONITOR PLATFORM - CENTRAL CONTAINER ENVIRONMENT CONFIGURATION
# ==============================================================================
IS_DOCKER=true
ENVIRONMENT=production
DB_INITIALIZED=true
# Database Cluster Infrastructure Routing
# - Inside Docker network, 'postgres' refers to the database service container name
#POSTGRES_HOST=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=64686

# Relational Database Credentials & Metadata Anchors
POSTGRES_DB=monitor_db
# POSTGRES_USER=postgres_admin
# POSTGRES_PASSWORD=Python.11.SQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=any_password
# Flask Core Application Security Constants
FLASK_ENV=production
SECRET_KEY=SuperSecretProductionKey2026!
PyJWT==2.8.0
bcrypt==4.1.2