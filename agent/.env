# ==============================================================================
# CENTRAL SERVER ROUTING CONFIGURATION
# ==============================================================================

# OPTION A: USE THIS FOR LOCAL WINDOWS TESTING (Your Current Setup)
# Server and Agent both run natively on Windows.
CENTRAL_SERVER_URL=http://127.0.0.1:5000/api/metrics/receiver

# OPTION B: USE THIS FOR PRODUCTION DOCKER CONTAINERS (Future Setup)
# Server runs inside Docker, Agent runs inside Docker on the same network bridge.
# CENTRAL_SERVER_URL=http://dashboard:5000/api/metrics/receiver

# OPTION C: USE THIS IF SERVER IS IN DOCKER BUT AGENT IS ON WINDOWS
# CENTRAL_SERVER_URL=http://host.docker.internal:5000/api/metrics/receiver


# ==============================================================================
# TELEMETRY PIPELINE & INTERVALS
# ==============================================================================
STREAM_INTERVAL_SECONDS=5


# ==============================================================================
# IDENTITY & NOMENCLATURE MATRIX
# ==============================================================================
# Change NODE_ID depending on your target representation in the frontend dashboard
NODE_ID=Docker_Production_Container
NODE_LOCATION=Ludwigshafen