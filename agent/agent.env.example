# =========================================================================
# SMART MONITOR AGENT - DEPLOYMENT ENVIRONMENT CONFIGURATION TEMPLATE
# Rename this file to '.env' on your target host node before running agent.py
# =========================================================================

# The full target API endpoint URL pointing to your central backend server
# - Localhost/127.0.0.1 if running directly on the host machine
# - 'http://backend:8082/api/metrics/receiver' if running inside Docker internal network
CENTRAL_SERVER_URL=http://backend:8082/api/metrics/receiver

# Time window gap (in seconds) between high-frequency telemetry packet transmissions
STREAM_INTERVAL_SECONDS=5

# Unique identifier for this hardware node (Standardized Nomenclature Matrix)
# Allowed Production Keys: 'Docker_Production_Container', 'Windows_Host', 'VMware_Ubuntu'
NODE_ID=Windows_Host

# Regional or structural location mapping to match frontend dashboard rendering
# Allowed Production Locations: 'Ludwigshafen', 'Mannheim', 'Heidelberg'
NODE_LOCATION=Mannheim
