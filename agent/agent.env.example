# =========================================================================
# Smart Monitor Agent - Deployment Environment Configuration Template
# Rename this file to '.env' on your target host node before running agent.py
# =========================================================================

# The full target API endpoint url pointing to your central backend server
CENTRAL_SERVER_URL=http://localhost:5000/api/metrics/receiver

# Unique identifier for this hardware node (Allowed: Docker_Production_Container, Windows_Host, VMware_Ubuntu)
NODE_ID=Windows_Host

# Regional or structural location of the hosting machine cluster
NODE_LOCATION=Ludwigshafen
